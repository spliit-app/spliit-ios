{
  "sourceLanguage": "en",
  "strings": {
    "A group needs at least one participant.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe doit compter au moins un participant."
          }
        }
      }
    },
    "All shares must be higher than 0.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les parts doivent être supérieures à 0."
          }
        }
      }
    },
    "Another participant already has this name.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre participant porte déjà ce nom."
          }
        }
      }
    },
    "Enter an exchange rate.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un taux de change."
          }
        }
      }
    },
    "Enter at least one character.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez au moins un caractère."
          }
        }
      }
    },
    "Enter at least two characters.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez au moins deux caractères."
          }
        }
      }
    },
    "Enter at most 50 characters.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez au plus 50 caractères."
          }
        }
      }
    },
    "Enter at most five characters.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez au plus cinq caractères."
          }
        }
      }
    },
    "Enter what was actually paid.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le montant réellement payé."
          }
        }
      }
    },
    "Invalid number.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre invalide."
          }
        }
      }
    },
    "Sum of amounts must equal the expense amount.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La somme des montants doit être égale au montant de la dépense."
          }
        }
      }
    },
    "Sum of percentages must equal 100.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La somme des pourcentages doit être égale à 100."
          }
        }
      }
    },
    "The amount must be lower than 10,000,000.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant doit être inférieur à 10 000 000."
          }
        }
      }
    },
    "The amount must not be zero.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant ne doit pas être nul."
          }
        }
      }
    },
    "The expense must be paid for at least one participant.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dépense doit être payée pour au moins un participant."
          }
        }
      }
    },
    "The rate must be strictly greater than zero.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de change doit être strictement supérieur à zéro."
          }
        }
      }
    },
    "This group’s currency code isn’t valid. Pick a currency, or choose a custom symbol.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code de devise de ce groupe n’est pas valide. Choisissez une devise, ou optez pour un symbole personnalisé."
          }
        }
      }
    },
    "You must enter an amount.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez saisir un montant."
          }
        }
      }
    },
    "You must select a participant.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez sélectionner un participant."
          }
        }
      }
    }
  },
  "version": "1.0"
}
