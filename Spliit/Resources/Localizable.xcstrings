    },
    "Adding, editing or deleting an expense is recorded here, and so is a change to the group itself.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ajout, la modification et la suppression d’une dépense sont consignés ici, tout comme les changements apportés au groupe lui-même."
