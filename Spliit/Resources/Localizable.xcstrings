{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "The entity's own name, shown as-is.",
      "shouldTranslate": false
    },
    "%@ / %@": {
      "comment": "A preview label pairing two names that are already localised.",
      "shouldTranslate": false
    },
    "%@ 1 = %@ %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 1 = %2$@ %3$@"
          }
        }
      }
    },
    "%@ added “%@”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a ajouté « %2$@ »."
          }
        }
      }
    },
    "%@ appears on at least one expense, so they can’t be removed. Delete or reassign those expenses first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ figure sur au moins une dépense et ne peut donc pas être retiré. Supprimez ou réattribuez ces dépenses d’abord."
          }
        }
      }
    },
    "%@ changed the group settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a modifié les paramètres du groupe."
          }
        }
      }
    },
    "%@ deleted “%@”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a supprimé « %2$@ »."
          }
        }
      }
    },
    "%@ over the total.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de trop par rapport au total."
          }
        }
      }
    },
    "%@ owes %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ owes %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ doit à %2$@"
          }
        }
      }
    },
    "%@ still to allocate.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ encore à répartir."
          }
        }
      }
    },
    "%@ updated “%@”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a mis à jour « %2$@ »."
          }
        }
      }
    },
    "%@ — the rate on %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — le taux du %2$@."
          }
        }
      }
    },
    "%@%% over 100%%.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %% de plus que 100 %%."
          }
        }
      }
    },
    "%@%% still to allocate.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %% encore à répartir."
          }
        }
      }
    },
    "%@groups/…": {
      "comment": "An example group URL, built from the instance's own address.",
      "shouldTranslate": false
    },
    "%@’s share": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part de %@"
          }
        }
      }
    },
    "%lld participants": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld participant"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld participants"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
